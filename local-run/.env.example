# Local-only HelloTest runtime defaults.
# Copy this file to local-run/.env before running bin/start.sh.

COMPOSE_PROJECT_NAME=hellotest-local

POSTGRES_DB=hellotest
POSTGRES_USER=hellotest
POSTGRES_PASSWORD=hellotest
POSTGRES_PORT=5432
POSTGRES_BIND=127.0.0.1

API_PORT=3000
API_BIND=127.0.0.1
FRONTEND_PORT=8080
FRONTEND_BIND=127.0.0.1
ADMIN_BIND=127.0.0.1
TESTENGINE_PORT=4301
TESTENGINE_BIND=127.0.0.1
MOBILE_ENGINE_PORT=4312
MOBILE_ENGINE_BIND=127.0.0.1
REDIS_BIND=127.0.0.1
JAEGER_BIND=127.0.0.1
JAEGER_OTLP_BIND=127.0.0.1

DATABASE_URL=postgresql://hellotest:hellotest@postgres:5432/hellotest
SESSION_SECRET=hellotest-local-dev-secret
CORS_ORIGIN=http://localhost:8080,http://localhost:5173
HELLOTEST_API_BASE_URL=/api

# Binary evidence storage. The API streams uploads to MinIO and keeps only
# scoped metadata/object keys in PostgreSQL.
STORAGE_PROVIDER=minio
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_API_BIND=127.0.0.1
MINIO_CONSOLE_BIND=127.0.0.1
MINIO_USE_SSL=false
MINIO_ROOT_USER=hellotest
MINIO_ROOT_PASSWORD=hellotest-minio-dev-secret
MINIO_ACCESS_KEY=hellotest
MINIO_SECRET_KEY=hellotest-minio-dev-secret
MINIO_BUCKET=hellotest-attachments
MINIO_REGION=us-east-1
MAX_ATTACHMENT_BYTES=104857600

# Project-scoped Knowledge Repo ingestion and bounded document extraction.
KNOWLEDGE_MAX_FILE_BYTES=52428800
KNOWLEDGE_EXTRACTION_MAX_BYTES=20971520
KNOWLEDGE_MAX_EXTRACTED_TEXT_CHARS=2000000
KNOWLEDGE_TIKA_URL=http://tika:9998
KNOWLEDGE_TIKA_TIMEOUT_MS=30000
# PostgreSQL owns canonical content and ACLs. Qdrant is a rebuildable semantic
# projection; it receives IDs/vectors/filter metadata, never canonical text.
KNOWLEDGE_VECTOR_STORE=qdrant
KNOWLEDGE_QDRANT_URL=http://qdrant:6333
KNOWLEDGE_QDRANT_API_KEY=
KNOWLEDGE_QDRANT_COLLECTION_PREFIX=hellotest_knowledge_dense_v1
KNOWLEDGE_QDRANT_TIMEOUT_MS=4000
QDRANT_BIND=127.0.0.1
QDRANT_PORT=6333

HELLOTEST_TESTENGINE_SECRET=hellotest-testengine-dev-secret
TESTENGINE_SHARED_SECRET=hellotest-testengine-dev-secret
MOBILE_ENGINE_SHARED_SECRET=hellotest-mobile-engine-dev-secret
TESTENGINE_API_REPLICAS=0
TESTENGINE_WEB_REPLICAS=1
TESTENGINE_ANDROID_REPLICAS=0
TESTENGINE_AUTOSCALE=true
TESTENGINE_AUTOSCALE_MIN_WORKERS=0
TESTENGINE_WEB_MIN_WORKERS=1
TESTENGINE_AUTOSCALE_MAX_WORKERS=3
TESTENGINE_AUTOSCALE_INTERVAL_SECONDS=15
TESTENGINE_POLL_INTERVAL_MS=30000
TESTENGINE_POLL_CONCURRENCY=4
ENGINE_NAME=hellotest-local-testengine
ENGINE_PUBLIC_URL=http://localhost:4301
MOBILE_ENGINE_URL=http://mobile-engine:4312
MOBILE_PROVIDER=local-appium
MOBILE_REMOTE_URL=
APPIUM_SERVER_URL=http://host.docker.internal:4723
ANDROID_DEVICE_NAME="Android Device"
ANDROID_PLATFORM_VERSION=
ANDROID_APP=
MOBILE_READINESS_TIMEOUT_MS=2000
MOBILE_REQUIRE_PROVIDER_READY=false
MOBILE_REMOTE_DOWNLOAD_TIMEOUT_MS=15000
MOBILE_REMOTE_DOWNLOAD_MAX_BYTES=26214400
MOBILE_SHUTDOWN_TIMEOUT_MS=10000
ARTIFACT_ROOT=/artifacts
RECORDER_HEADLESS=true

# Used by the Test Engine worker when pulling queued jobs from the API.
HELLOTEST_WORKER_API_BASE_URL=http://api:3000

# Image stack defaults for docker-compose.images.yml.
HELLOTEST_BACKEND_IMAGE=jayarajumetta/hellotest-backend:latest
HELLOTEST_FRONTEND_IMAGE=jayarajumetta/hellotest-frontend:latest
HELLOTEST_TESTENGINE_IMAGE=jayarajumetta/hellotest-testengine:latest
HELLOTEST_MOBILE_ENGINE_IMAGE=jayarajumetta/hellotest-mobile-engine:latest
