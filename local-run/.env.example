# Local-only QAira runtime defaults.
# Copy this file to local-run/.env before running bin/start.sh.

COMPOSE_PROJECT_NAME=qaira-local

POSTGRES_DB=qaira
POSTGRES_USER=qaira
POSTGRES_PASSWORD=qaira
POSTGRES_PORT=5432

API_PORT=3000
FRONTEND_PORT=8080
TESTENGINE_PORT=4301
MOBILE_ENGINE_PORT=4312

DATABASE_URL=postgresql://qaira:qaira@postgres:5432/qaira
SESSION_SECRET=qaira-local-dev-secret
CORS_ORIGIN=http://localhost:8080,http://localhost:5173
QAIRA_API_BASE_URL=/api

# Binary evidence storage. The API streams uploads to MinIO and keeps only
# scoped metadata/object keys in PostgreSQL.
STORAGE_PROVIDER=minio
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_ROOT_USER=qaira
MINIO_ROOT_PASSWORD=qaira-minio-dev-secret
MINIO_ACCESS_KEY=qaira
MINIO_SECRET_KEY=qaira-minio-dev-secret
MINIO_BUCKET=qaira-attachments
MINIO_REGION=us-east-1
MAX_ATTACHMENT_BYTES=104857600

QAIRA_TESTENGINE_SECRET=qaira-testengine-dev-secret
TESTENGINE_SHARED_SECRET=qaira-testengine-dev-secret
TESTENGINE_API_REPLICAS=0
TESTENGINE_WEB_REPLICAS=0
TESTENGINE_ANDROID_REPLICAS=0
TESTENGINE_AUTOSCALE=true
TESTENGINE_AUTOSCALE_MIN_WORKERS=0
TESTENGINE_AUTOSCALE_MAX_WORKERS=3
TESTENGINE_AUTOSCALE_INTERVAL_SECONDS=15
TESTENGINE_POLL_INTERVAL_MS=30000
TESTENGINE_POLL_CONCURRENCY=4
ENGINE_NAME=qaira-local-testengine
ENGINE_PUBLIC_URL=http://localhost:4301
MOBILE_ENGINE_URL=http://mobile-engine:4312
APPIUM_SERVER_URL=http://host.docker.internal:4723
ANDROID_DEVICE_NAME="Android Device"
ANDROID_PLATFORM_VERSION=
ANDROID_APP=
ARTIFACT_ROOT=/artifacts
RECORDER_HEADLESS=true

# Used by the Test Engine worker when pulling queued jobs from the API.
QAIRA_WORKER_API_BASE_URL=http://api:3000

# Image stack defaults for docker-compose.images.yml.
QAIRA_BACKEND_IMAGE=jayarajumetta/qaira-backend:latest
QAIRA_FRONTEND_IMAGE=jayarajumetta/qaira-frontend:latest
QAIRA_TESTENGINE_IMAGE=jayarajumetta/qaira-testengine:latest
QAIRA_MOBILE_ENGINE_IMAGE=jayarajumetta/qaira-mobile-engine:latest
