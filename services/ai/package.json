  "scripts": {
    "build": "node ../../scripts/build/capability-ui.mjs ai",
    "start": "node backend/server.cjs",
    "test": "node ../../scripts/checks/test-capability.mjs ai",
    "dev": "npm --prefix ../platform/frontend run dev",
    "dev:api": "node backend/server.cjs"
  },
  "hellotest": {
    "id": "ai",
    "requires": [
      "manual",
      "knowledge",
      "integration"
    ],
    "uiProtocol": 1,
    "features": [
      "hellotest.ai.automation",
      "hellotest.ai.bug_triage",
      "hellotest.ai.content_rephrase",
      "hellotest.ai.execution_analysis",
      "hellotest.ai.quality_insights",
      "hellotest.ai.requirement_design",
      "hellotest.ai.test_authoring",
      "hellotest.ai.test_data_generation"
    ]
  },
  "dependencies": {
    "@hellotest/agentic": "^1.0.0",
    "@hellotest/integration": "^1.0.0",
    "@hellotest/knowledge": "^1.0.0",
    "@hellotest/manual": "^1.0.0",
    "@hellotest/platform": "^1.0.0",
    "@hellotest/testing": "^1.0.0",
    "acorn": "8.18.0",
    "@hellotest/trace": "^1.0.0",
    "@hellotest/automation": "^1.0.0"
  }
