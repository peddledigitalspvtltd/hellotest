{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "target": "ES2020",
    "noEmit": true
  },
  "include": [
    "vite.config.ts",
    "vite.admin.config.ts",
    "vite.feature-sources.ts",
    "package.json",
    "../../catalog.json"
  ]
}
