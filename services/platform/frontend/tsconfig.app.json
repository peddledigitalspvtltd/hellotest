{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": "./src",
    "paths": {
      "*": [
        "../node_modules/*",
        "../node_modules/@types/*"
      ],
      "react": [
        "../node_modules/@types/react"
      ],
      "react/*": [
        "../node_modules/@types/react/*"
      ],
      "react-dom": [
        "../node_modules/@types/react-dom"
      ],
      "react-dom/*": [
        "../node_modules/@types/react-dom/*"
      ]
    }
  },
  "include": [
    "src",
    "admin",
    "pages",
    "components",
    "entry.ts",
    "../../*/frontend/entry.ts",
    "../../*/frontend/index.ts"
  ]
}
