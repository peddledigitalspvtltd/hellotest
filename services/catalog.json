  "operations": [
    {
      "id": "haproxy",
      "kind": "operations",
      "source": "ops/haproxy",
      "port": 18404,
      "health": "/health",
      "memory_limit_mib": 64,
      "required_for_application_readiness": false
    },
    {
      "id": "prometheus",
      "kind": "operations",
      "source": "ops/prometheus",
      "port": 9090,
      "health": "/-/ready",
      "memory_limit_mib": 256,
      "required_for_application_readiness": false
    },
    {
      "id": "grafana",
      "kind": "operations",
      "source": "ops/grafana",
      "port": 3001,
      "health": "/api/ops-telemetry/grafana/api/health",
      "memory_limit_mib": 256,
      "required_for_application_readiness": false
    },
    {
      "id": "loki",
      "kind": "operations",
      "source": "ops/loki",
      "port": 3100,
      "health": "/ready",
      "memory_limit_mib": 384,
      "required_for_application_readiness": false
    },
    {
      "id": "jaeger",
      "kind": "operations",
      "source": "ops/jaeger",
      "port": 16687,
      "health": "/status",
      "memory_limit_mib": 256,
      "required_for_application_readiness": false,
      "health_port": 13133
    },
    {
      "id": "alloy",
      "kind": "operations",
      "source": "ops/alloy",
      "port": 12345,
