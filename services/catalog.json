{
  "version": 1,
  "principles": {
    "route_ownership": "Every API route belongs to exactly one profile.",
    "source_ownership": "Capability routes, use cases and workers live under services/<profile>/backend; UI and API clients live under services/<profile>/frontend. services/platform/backend and frontend compose shared runtime adapters and UI foundations.",
    "shared_runtime": "API profiles share the backend package and Platform foundation. Profiles isolate route and worker ownership; separate processes do not imply independent data ownership.",
    "database": "The current deployment uses shared PostgreSQL. A database split requires an explicit data-ownership and compatibility design; network wrappers alone do not provide isolation."
  },
  "services": [
    {
      "id": "api-platform",
      "kind": "api",
      "profile": "platform",
      "port": 3010,
      "source": "services/platform/backend",
      "runtime_source": "services/platform/backend",
      "frontend_source": "services/platform/frontend",
      "health": "/health/ready",
      "owns": [
        "identity",
        "projects",
        "access-control",
        "workspace-administration",
        "instance-setup"
      ],
      "requires": []
    },
    {
      "id": "api-testing",
      "kind": "api",
      "profile": "testing",
      "port": 3011,
      "source": "services/testing/backend",
      "runtime_source": "services/platform/backend",
      "frontend_source": "services/testing/frontend",
      "health": "/health/ready",
      "owns": [
        "test-cases",
        "test-suites",
        "shared-steps",
        "environments",
        "test-data",
        "configurations",
        "executions",
        "bugs"
      ],
      "requires": [
        "platform"
      ]
    },
    {
      "id": "api-knowledge",
      "kind": "api",
      "profile": "knowledge",
      "port": 3012,
      "source": "services/knowledge/backend",
      "runtime_source": "services/platform/backend",
      "frontend_source": "services/knowledge/frontend",
      "health": "/health/ready",
      "owns": [
        "knowledge-ingestion",
        "knowledge-search",
        "context-retrieval"
      ],
      "requires": [
        "platform",
        "integration"
      ]
    },
    {
      "id": "api-manual",
      "kind": "api",
      "profile": "manual",
      "port": 3002,
      "source": "services/manual/backend",
      "runtime_source": "services/platform/backend",
      "frontend_source": "services/manual/frontend",
      "health": "/health/ready",
      "owns": [
        "requirements",
        "planning",
        "work-item-relationships"
      ],
      "requires": [
        "testing"
      ]
    },
    {
      "id": "api-dashboard",
      "kind": "api",
      "profile": "dashboard",
      "port": 3003,
      "source": "services/dashboard/backend",
      "runtime_source": "services/platform/backend",
