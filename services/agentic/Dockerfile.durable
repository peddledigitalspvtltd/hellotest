# The Temporal native worker requires glibc. Keep it separate from the Alpine API.
FROM node:22-bookworm-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-yaml ca-certificates && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
COPY services ./services
RUN npm ci --prefix services/platform/backend --omit=dev --no-audit --no-fund && npm ci --omit=dev --ignore-scripts --no-audit --no-fund && npm cache clean --force
ENV NODE_ENV=production HELLOTEST_SERVICE_PROFILE=agentic HELLOTEST_SCHEMA_MODE=verify
USER node
CMD ["node", "services/agentic/backend/workflows/temporal/worker.cjs"]
