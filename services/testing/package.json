    "./frontend/lib/gherkin": "./frontend/lib/gherkin.ts",
    "./frontend/lib/hierarchyDrag": "./frontend/lib/hierarchyDrag.ts",
    "./frontend/lib/hierarchyPagination": "./frontend/lib/hierarchyPagination.ts",
    "./frontend/lib/runHooks": "./frontend/lib/runHooks.ts",
    "./frontend/lib/testCaseImport": "./frontend/lib/testCaseImport.ts",
    "./frontend/pages/DesignPage": "./frontend/pages/DesignPage.tsx",
    "./frontend/pages/ExecutionsPage": "./frontend/pages/ExecutionsPage.tsx",
