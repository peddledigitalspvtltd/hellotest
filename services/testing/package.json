    "./backend/services/executionPlanPreconditions.service": "./backend/services/executionPlanPreconditions.service.js",
    "./backend/services/executionResult.service": "./backend/services/executionResult.service.js",
    "./backend/services/issues.service": "./backend/services/issues.service.js",
    "./backend/services/testCase.service": "./backend/services/testCase.service.js",
    "./backend/services/linkedManualParameters.service": "./backend/services/linkedManualParameters.service.js",
    "./backend/services/effectiveCaseDataSets.service": "./backend/services/effectiveCaseDataSets.service.js",
    "./backend/services/suiteExecutionContext.service": "./backend/services/suiteExecutionContext.service.js",
    "./backend/services/testCaseModule.service": "./backend/services/testCaseModule.service.js",
    "./backend/services/testCaseScope.service": "./backend/services/testCaseScope.service.js",
    "./backend/services/testConfiguration.service": "./backend/services/testConfiguration.service.js",
    "./backend/services/testDataSet.service": "./backend/services/testDataSet.service.js",
