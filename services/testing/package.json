  "scripts": {
    "build": "node ../../scripts/build/capability-ui.mjs testing",
    "start": "node backend/server.cjs",
    "test": "node ../../scripts/checks/test-capability.mjs testing",
    "dev": "npm --prefix ../platform/frontend run dev",
    "dev:api": "node backend/server.cjs"
  },
  "hellotest": {
    "id": "testing",
    "requires": [
      "platform"
    ],
    "uiProtocol": 1,
    "features": [
      "hellotest.automation.batch_process",
      "hellotest.manual.bugs",
      "hellotest.manual.environments",
      "hellotest.manual.run_gherkin",
      "hellotest.manual.runs",
      "hellotest.manual.suites",
      "hellotest.manual.test_cases",
      "hellotest.manual.test_data"
    ]
  },
  "dependencies": {
    "@hellotest/agentic": "^1.0.0",
    "@hellotest/ai": "^1.0.0",
    "@hellotest/automation": "^1.0.0",
    "@hellotest/dashboard": "^1.0.0",
    "@hellotest/integration": "^1.0.0",
    "@hellotest/manual": "^1.0.0",
    "@hellotest/platform": "^1.0.0",
    "@hellotest/trace": "^1.0.0"
  }
}
