{
  "name": "@hellotest/automation",
  "version": "1.0.0",
  "private": true,
  "description": "HelloTest automation capability: UI, API and workers",
  "files": [
    "backend",
    "frontend",
    "shared",
    "dist/ui",
    "package.json",
    "README.md"
  ],
  "exports": {
    "./shared/playwrightArtifact": "./shared/playwrightArtifact.mjs",
    "./backend": "./backend/service.manifest.js",
    "./backend/workers": "./backend/workers.js",
    "./client": "./frontend/api.client.ts",
    "./frontend/api.client": "./frontend/api.client.ts",
    "./frontend/components/RecorderSessionInsights": "./frontend/components/RecorderSessionInsights.tsx",
    "./frontend/components/RecorderStartControls": "./frontend/components/RecorderStartControls.tsx",
    "./frontend/components/StepAutomationEditor": "./frontend/components/StepAutomationEditor.tsx",
    "./frontend/components/VisualTestBuilder": "./frontend/components/VisualTestBuilder.tsx",
    "./frontend/index": "./frontend/index.ts",
    "./frontend/hooks/useAutomationBuildParameters": "./frontend/hooks/useAutomationBuildParameters.tsx",
    "./frontend/lib/automationAccess": "./frontend/lib/automationAccess.ts",
    "./frontend/lib/automationRuntime": "./frontend/lib/automationRuntime.ts",
    "./frontend/lib/automationStartUrl": "./frontend/lib/automationStartUrl.ts",
    "./frontend/lib/junitImport": "./frontend/lib/junitImport.ts",
    "./frontend/lib/postmanImport": "./frontend/lib/postmanImport.ts",
    "./frontend/lib/stepAutomation": "./frontend/lib/stepAutomation.ts",
    "./frontend/lib/testNgImport": "./frontend/lib/testNgImport.ts",
    "./frontend/pages/AutomationPage": "./frontend/pages/AutomationPage.tsx",
    "./package.json": "./package.json",
    "./ui": "./frontend/entry.ts",
    "./frontend/lib/repositoryEntries": "./frontend/lib/repositoryEntries.ts",
    "./frontend/lib/automationGherkin": "./frontend/lib/automationGherkin.ts",
    "./frontend/components/AutomationSourceSections": "./frontend/components/AutomationSourceSections.tsx",
    "./frontend/components/SharedAutomationSectionsEditor": "./frontend/components/SharedAutomationSectionsEditor.tsx",
    "./frontend/lib/localAgentPairing": "./frontend/lib/localAgentPairing.ts",
    "./shared/apiSourceIntake": "./shared/apiSourceIntake.mjs",
    "./frontend/components/ApiAutomationSourceIntake": "./frontend/components/ApiAutomationSourceIntake.tsx",
    "./repair": "./backend/services/automationRepair.service.js",
    "./frontend/components/AutomationRepairReview": "./frontend/components/AutomationRepairReview.tsx",
    "./build": "./backend/services/aiAutomationBuilder.service.js",
    "./frontend/components/RepositoryInspectBrowser": "./frontend/components/RepositoryInspectBrowser.tsx",
    "./frontend/components/RepositoryInspectControls": "./frontend/components/RepositoryInspectControls.tsx",
    "./frontend/hooks/useRepositoryInspectAgent": "./frontend/hooks/useRepositoryInspectAgent.ts",
    "./frontend/lib/repositoryBrowserBridge": "./frontend/lib/repositoryBrowserBridge.ts",
    "./frontend/lib/repositoryInspectSession": "./frontend/lib/repositoryInspectSession.ts",
    "./frontend/lib/repositoryWorkspace": "./frontend/lib/repositoryWorkspace.ts",
    "./inspection-client": "./frontend/lib/repositoryInspectionApi.ts",
    "./frontend/hooks/useAutomationActivityStream": "./frontend/hooks/useAutomationActivityStream.ts",
    "./activity-client": "./frontend/lib/automationActivityStream.ts",
    "./browser-agent": "./backend/lib/browser/automationBrowserAgent.js",
    "./upstream": "./backend/lib/upstream/automationUpstreamEngineer.js",
    "./parameters": "./backend/lib/parameters/automationBrowserParameters.js",
    "./build-options": "./backend/lib/build/automationBuildPipelineOptions.js",
    "./repair-program": "./backend/lib/verification/automationRepairProgramContract.js",
    "./dispatch": "./backend/services/testEngineDispatch.service.js",
    "./requests": "./backend/services/apiRequestExecution.service.js",
    "./generator": "./backend/services/automationGenerator.service.js",
    "./build-parameters": "./backend/services/automationBuildParameterPlan.service.js",
    "./queued-start-url": "./backend/services/automationQueuedStartUrl.service.js",
    "./activity": "./backend/services/automationAgentActivity.service.js",
    "./retained-source": "./backend/services/automationRetainedSourcePreview.service.js",
    "./instruction-mapping": "./backend/services/automationInstructionMapping.service.js",
    "./paired-execution": "./backend/services/pairedLocalExecution.service.js",
    "./browser-bridge": "./backend/services/pairedBrowserBridge.service.js",
    "./schemas/paired-execution": "./backend/pairedExecutionSchema.js",
    "./schemas/recording-import": "./backend/recordingImportSchema.js",
    "./object-source-context": "./backend/lib/build/automationObjectSourceContext.js",
    "./authoring-admission": "./backend/services/automationAuthoringAdmission.service.js"
  },
  "scripts": {
    "build": "node ../../scripts/build/capability-ui.mjs automation",
    "start": "node backend/server.cjs",
    "test": "node ../../scripts/checks/test-capability.mjs automation",
    "dev": "npm --prefix ../platform/frontend run dev",
    "dev:api": "node backend/server.cjs"
  },
  "hellotest": {
    "id": "automation",
    "requires": [
      "testing",
      "integration"
    ],
    "uiProtocol": 1,
    "features": [
      "hellotest.automation.assets",
      "hellotest.automation.builder",
      "hellotest.automation.local_execution",
      "hellotest.automation.object_repository",
      "hellotest.automation.parallel_execution",
      "hellotest.automation.preview",
      "hellotest.automation.remote_execution",
      "hellotest.automation.step_code",
      "hellotest.automation.step_recording",
      "hellotest.automation.workspace",
      "hellotest.mobile.appium"
    ]
  },
  "dependencies": {
    "@hellotest/ai": "^1.0.0",
    "@hellotest/dashboard": "^1.0.0",
    "@hellotest/integration": "^1.0.0",
    "@hellotest/knowledge": "^1.0.0",
    "@hellotest/manual": "^1.0.0",
    "@hellotest/mcp": "^1.0.0",
    "@hellotest/platform": "^1.0.0",
    "@hellotest/testing": "^1.0.0",
    "@hellotest/trace": "^1.0.0",
    "acorn": "8.18.0",
    "ajv": "8.20.0",
    "yaml": "2.9.1",
    "@hellotest/contracts": "^1.0.0"
  }
}
