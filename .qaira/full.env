APP_MODE=docker
QAIRA_PUBLIC_URL=http://localhost:8080
QAIRA_API_PUBLIC_URL=http://localhost:3000
QAIRA_API_BASE_URL=/api
QAIRA_API_INTERNAL_URL=http://api:3000
QAIRA_WORKER_API_BASE_URL=http://api:3000
ENGINE_PUBLIC_URL=http://localhost:4301
MOBILE_ENGINE_URL=http://mobile-engine:4312
APPIUM_SERVER_URL=http://host.docker.internal:4723
DATABASE_URL=postgresql://qaira:qaira@postgres:5432/qaira
OBS_DATABASE_URL=postgresql://qaira:qaira@postgres:5432/qaira
REDIS_URL=redis://redis:6379
POSTGRES_DB=qaira
POSTGRES_USER=qaira
POSTGRES_PASSWORD=qaira
SESSION_SECRET=qaira-dev-secret
CORS_ORIGIN=http://localhost:8080,http://localhost:5173,http://localhost:8080
QAIRA_TESTENGINE_SECRET=qaira-testengine-dev-secret
TESTENGINE_SHARED_SECRET=qaira-testengine-dev-secret
ENABLE_OBSERVABILITY=false
QAIRA_BACKEND_IMAGE=jayarajumetta/qaira-backend:latest
QAIRA_FRONTEND_IMAGE=jayarajumetta/qaira-frontend:latest
QAIRA_TESTENGINE_IMAGE=jayarajumetta/qaira-testengine:latest
QAIRA_MOBILE_ENGINE_IMAGE=jayarajumetta/qaira-mobile-engine:latest
FRONTEND_PORT=8080
API_PORT=3000
TESTENGINE_PORT=4301
MOBILE_ENGINE_PORT=4312
REDIS_PORT=6379
QAIRA_HTTP_PORT=80
QAIRA_HTTP_BIND=0.0.0.0
QAIRA_API_BIND=127.0.0.1
QAIRA_POSTGRES_BIND=127.0.0.1
QAIRA_HAPROXY_STATS_BIND=127.0.0.1
QAIRA_PROMETHEUS_BIND=127.0.0.1
QAIRA_LOKI_BIND=127.0.0.1
QAIRA_GRAFANA_BIND=127.0.0.1
QAIRA_OTEL_GRPC_BIND=127.0.0.1
QAIRA_OTEL_HTTP_BIND=127.0.0.1
QAIRA_OTEL_METRICS_BIND=127.0.0.1
TESTENGINE_BIND=0.0.0.0
SELENIUM_GRID_BIND=127.0.0.1
SELENIUM_VNC_BIND=127.0.0.1
