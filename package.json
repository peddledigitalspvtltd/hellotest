{
  "name": "hellotest-platform",
  "version": "1.0.0",
  "private": true,
  "description": "HelloTest platform workspace and service orchestration commands",
  "scripts": {
    "setup": "npm run setup:backend && npm run setup:frontend && npm run setup:testengine && npm run setup:mobile && npm run setup:capabilities",
    "setup:backend": "npm ci --prefix services/platform/backend",
    "setup:frontend": "npm ci --prefix services/platform/frontend",
    "setup:testengine": "npm ci --prefix testengine/backend",
    "setup:mobile": "npm install --prefix local-run/mobile-engine --ignore-scripts",
    "test": "npm run test:backend && npm run test:frontend && npm run test:testengine && npm run test:architecture && npm run audit:source-layout && npm run audit:modules && npm run validate:architecture && npm run check:boundaries",
    "test:backend": "npm --prefix services/platform/backend test",
    "test:frontend": "npm --prefix services/platform/frontend test",
    "test:testengine": "npm --prefix testengine/backend test",
    "build": "npm run build:frontend && npm run build:testengine",
    "build:frontend": "npm --prefix services/platform/frontend run build:all",
    "build:testengine": "npm --prefix testengine/backend run build",
    "audit:source-layout": "node scripts/checks/audit-source-layout.mjs --strict",
    "test:service-gateway": "node scripts/checks/test-service-gateway.mjs",
    "validate:architecture": "node scripts/checks/validate-service-architecture.mjs",
    "microservices:up": "node scripts/deploy/capabilities.mjs --build",
    "microservices:down": "node scripts/deploy/capabilities.mjs --down",
    "ops:up": "node scripts/ops/stack.mjs up",
    "ops:status": "node scripts/ops/stack.mjs status",
    "ops:verify": "node scripts/ops/verify.mjs",
    "audit:modules": "node scripts/checks/audit-module-graph.mjs",
    "test:architecture": "node scripts/checks/sync-capability-metadata.mjs --check && node scripts/build/gherkin-runtime.mjs --check && node --test scripts/checks/*.test.mjs",
    "audit:clones": "node scripts/checks/report-function-clones.mjs",
    "services:up": "node scripts/deploy/capabilities.mjs",
    "check:boundaries": "node scripts/checks/check-service-boundaries.mjs",
    "build:capabilities": "node scripts/build/capability-ui.mjs all",
    "setup:capabilities": "npm ci --ignore-scripts --no-audit --no-fund",
    "generate:capabilities": "node scripts/checks/sync-capability-metadata.mjs",
    "doctor": "node scripts/dev/doctor.mjs",
    "build:minio": "sh scripts/build/minio.sh",
    "check:mcp": "node scripts/build/mcp-contracts.mjs --check && node scripts/checks/mcp-feature-inventory.mjs --check",
    "audit:mcp:features": "node scripts/checks/mcp-feature-inventory.mjs --check",
    "generate:mcp:coverage": "node scripts/checks/mcp-feature-inventory.mjs --markdown --check",
    "test:mcp": "npm test --workspace @hellotest/mcp",
    "test:mcp:postgres": "node scripts/checks/test-mcp-postgres.mjs",
    "test:ai-attachments": "node scripts/checks/test-ai-attachments.mjs",
    "test:ai-requests": "node --test services/platform/backend/test/aiRequestEnvelope.test.js services/integration/test/backend/llmRequestPolicy.test.js services/knowledge/test/backend/knowledgeModelEfficiency.test.js services/agentic/test/backend/agentContextFallback.test.js services/agentic/test/backend/specialistChain.test.js services/ai/test/backend/structuredReview.test.js services/ai/test/backend/aiGenerationPersistenceRetry.test.js",
    "test:ai-features": "node --test --test-concurrency=4 services/agentic/test/backend/*.test.js services/agentic/test/frontend/*.test.mjs services/ai/test/backend/*.test.js services/ai/test/frontend/*.test.mjs services/automation/test/backend/*.test.js services/automation/test/frontend/*.test.mjs services/chatbot/test/backend/*.test.js services/chatbot/test/frontend/*.test.mjs services/knowledge/test/backend/*.test.js services/manual/test/backend/*.test.js services/platform/backend/test/ai*.test.js services/platform/backend/test/automationBuildPersistence.test.js services/platform/frontend/test/agenticExperienceContract.test.mjs services/platform/test/backend/storyOptionalEvidence.test.js",
    "test:agent-intents": "node --test services/agentic/test/backend/agentIntentEvaluation.test.js services/agentic/test/backend/agentOutcomeContracts.test.js services/agentic/test/backend/qualityAgentEngineContract.test.js services/agentic/test/backend/qualityAgentSkills.test.js services/agentic/test/backend/agentContextContracts.test.js services/platform/backend/test/aiFeatureIntentMatrix.test.js",
    "test:workflows": "node --test services/agentic/test/backend/workflow*.test.js services/platform/backend/test/agentWorkflowExecution.test.js services/platform/backend/test/agentWorkspaceReliability.test.js",
    "test:workflows:temporal": "node scripts/checks/test-workflow-temporal-postgres.mjs",
    "test:quality-agents": "node --test services/agentic/test/backend/quality*.test.js services/agentic/test/backend/browserMissionPlanner.test.js services/platform/backend/test/llmStreamingResponse.test.js",
    "test:quality-agent-engine": "npm --prefix testengine/backend run build && node --test --test-concurrency=1 testengine/backend/test/qualityAgents.test.mjs testengine/backend/test/qualityAgentDeployment.test.mjs",
    "test:quality-agents:postgres": "node scripts/checks/test-quality-agents-postgres.mjs",
    "test:repository-knowledge": "node scripts/checks/test-repository-knowledge.mjs",
    "test:repository-agents": "python3 -m unittest discover -s services/agentic/backend/runtime/semantic_compiler/tests -p 'test_*.py'",
    "test:knowledge:postgres": "node scripts/checks/test-knowledge-postgres.mjs",
    "test:product-ux": "node scripts/checks/test-product-experience.mjs",
    "check:docs": "node scripts/checks/check-docs.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "services/*"
  ],
  "devDependencies": {
    "typescript": "^5.6.3",
    "fastify": "^5.11.2"
  }
}
