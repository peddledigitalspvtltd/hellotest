{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend API",
      "type": "pwa-node",
      "request": "launch",
      "cwd": "${workspaceFolder}/services/platform/backend",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--watch",
        "--inspect=127.0.0.1:9230"
      ],
      "program": "${workspaceFolder}/services/platform/backend/src/server.js",
      "console": "integratedTerminal",
      "outputCapture": "std",
      "autoAttachChildProcesses": true,
      "skipFiles": [
        "<node_internals>/**"
      ],
      "preLaunchTask": "postgres:up",
      "envFile": "${workspaceFolder}/.env.development.local",
      "env": {
        "NODE_ENV": "development",
        "PORT": "3000"
      }
    },
    {
      "name": "Backend API (Attach 9230)",
      "type": "pwa-node",
      "request": "attach",
      "port": 9230,
      "cwd": "${workspaceFolder}/services/platform/backend",
      "restart": true,
      "skipFiles": [
        "<node_internals>/**"
      ],
      "address": "127.0.0.1"
    },
    {
      "name": "Test Engine",
      "type": "pwa-node",
      "request": "launch",
      "cwd": "${workspaceFolder}/testengine/backend",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--watch",
        "--inspect=127.0.0.1:9231",
        "--import",
        "tsx"
      ],
      "program": "${workspaceFolder}/testengine/backend/src/server.ts",
      "console": "integratedTerminal",
      "outputCapture": "std",
      "autoAttachChildProcesses": true,
      "skipFiles": [
        "<node_internals>/**"
      ],
      "envFile": "${workspaceFolder}/.env.development.local",
      "env": {
        "NODE_ENV": "development",
        "PORT": "4301",
        "ARTIFACT_ROOT": "${workspaceFolder}/local-run/artifacts"
      }
    },
    {
      "name": "Test Engine (Attach 9231)",
      "type": "pwa-node",
      "request": "attach",
      "port": 9231,
      "cwd": "${workspaceFolder}/testengine/backend",
      "restart": true,
      "skipFiles": [
        "<node_internals>/**"
      ],
      "address": "127.0.0.1"
    },
    {
      "name": "Frontend",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/services/platform/frontend",
      "sourceMaps": true,
      "preLaunchTask": "frontend:dev"
    },
    {
      "name": "Admin Frontend",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:5174/admin/",
      "webRoot": "${workspaceFolder}/services/platform/frontend",
      "sourceMaps": true,
      "preLaunchTask": "frontend:admin:dev"
    },
    {
      "name": "Mobile Engine",
      "type": "pwa-node",
      "request": "launch",
      "cwd": "${workspaceFolder}/local-run/mobile-engine",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--watch",
        "--inspect=127.0.0.1:9232"
      ],
      "program": "${workspaceFolder}/local-run/mobile-engine/src/server.js",
      "console": "integratedTerminal",
      "outputCapture": "std",
      "autoAttachChildProcesses": true,
      "skipFiles": [
        "<node_internals>/**"
      ],
      "envFile": "${workspaceFolder}/.env.development.local",
      "env": {
        "NODE_ENV": "development",
        "PORT": "4312"
      }
    },
    {
      "name": "Mobile Engine (Attach 9232)",
      "type": "pwa-node",
      "request": "attach",
      "address": "127.0.0.1",
      "port": 9232,
      "cwd": "${workspaceFolder}/local-run/mobile-engine",
      "restart": true,
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "Node Test (Current File)",
      "type": "pwa-node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--test",
        "--test-concurrency=1"
      ],
      "program": "${file}",
      "console": "integratedTerminal",
      "outputCapture": "std",
      "autoAttachChildProcesses": true,
      "skipFiles": [
        "<node_internals>/**"
      ],
      "envFile": "${workspaceFolder}/.env.development.local",
      "env": {
        "NODE_ENV": "test"
      }
    },
    {
      "name": "TypeScript Test (Current File)",
      "type": "pwa-node",
      "request": "launch",
      "cwd": "${workspaceFolder}/testengine/backend",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--import",
        "tsx",
        "--test",
        "--test-concurrency=1"
      ],
      "program": "${file}",
      "console": "integratedTerminal",
      "outputCapture": "std",
      "autoAttachChildProcesses": true,
      "sourceMaps": true,
      "skipFiles": [
        "<node_internals>/**"
      ],
      "envFile": "${workspaceFolder}/.env.development.local",
      "env": {
        "NODE_ENV": "test"
      }
    },
    {
      "name": "Local Docker: platform",
      "type": "pwa-node",
      "request": "attach",
      "address": "127.0.0.1",
      "port": 9240,
      "localRoot": "${workspaceFolder}",
      "remoteRoot": "/app",
      "preLaunchTask": "debug:local:platform",
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**"
      ]
    },
    {
      "name": "Local Docker: testing",
