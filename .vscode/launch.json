      "type": "pwa-node",
      "request": "attach",
      "address": "127.0.0.1",
      "port": 9241,
      "localRoot": "${workspaceFolder}/testengine/backend",
      "remoteRoot": "/app",
      "preLaunchTask": "debug:local:testengine-api-worker",
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**"
      ],
      "outFiles": [
        "${workspaceFolder}/testengine/backend/dist/**/*.js"
      ],
      "sourceMapPathOverrides": {
