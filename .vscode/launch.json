    {
      "name": "Local Docker: mobile-engine",
      "type": "pwa-node",
      "request": "attach",
      "address": "127.0.0.1",
      "port": 9244,
      "localRoot": "${workspaceFolder}/local-run/mobile-engine",
      "remoteRoot": "/app",
