    {
      "name": "Local Docker: UI",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:8080",
      "webRoot": "${workspaceFolder}/services/platform/frontend",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "*services/*": "${workspaceFolder}/services/*",
        "../../src/*": "${workspaceFolder}/services/platform/frontend/src/*",
        "../../admin/*": "${workspaceFolder}/services/platform/frontend/admin/*",
        "../../pages/*": "${workspaceFolder}/services/platform/frontend/pages/*",
        "../../../../*": "${workspaceFolder}/services/*"
      }
    }
  ],
  "compounds": [
    {
      "name": "Local Docker: Chatbot UI + Backend",
      "configurations": [
        "Local Docker: chatbot",
        "Local Docker: UI"
      ],
      "stopAll": true
    },
    {
      "name": "Full Stack Debug",
      "configurations": [
        "Backend API",
        "Test Engine",
        "Frontend"
      ],
      "stopAll": true
    },
    {
      "name": "API + Test Engine Debug",
      "configurations": [
        "Backend API",
        "Test Engine"
      ],
      "stopAll": true
    }
  ]
}
