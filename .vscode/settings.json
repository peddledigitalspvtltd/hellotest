{
  "qaira.outputDir": "out/qaira-output",
  "qaira.learningDir": "out/qaira-learning",

  "qaira.configPath": "",

  "qaira.docker.image": "jayarajumetta/semantic-compiler:1.9.2",
  "qaira.docker.pullPolicy": "always",

  "qaira.import.apiTests.enabled": true,
  "qaira.import.webuiPages.enabled": true,
  "qaira.import.apiTestsUrl": "http://localhost:8080/api/test-cases/import",
  "qaira.import.webuiPagesUrl": "http://localhost:8080/api/test-cases/automation/learning-cache/import",
  "qaira.import.appTypeId": "fb1192f3-9421-4012-b616-c13bbcb5bbe3",
  "qaira.import.authMode": "x-api-key",
  "qaira.import.confirmBeforeSending": true,

  "qaira.llm.enable": "true",
  "qaira.llm.provider": "openai",
  "qaira.llm.endpoint": "https://api.openai.com/v1/chat/completions",
  "qaira.llm.model": "gpt-4.1-mini",
  "qaira.llm.executeNetworkCalls": true,
  "qaira.llm.callsPerRun": 12,
  "qaira.llm.timeoutSeconds": 45,

  "qaira.component.framework": "auto",
  "qaira.component.executionMode": "local",
  "qaira.component.ctWorkspaceDir": "generated/component-ct",
  "qaira.component.workspaceMode": "shadow",

  "qaira.component.matureValidationTests": true,
  "qaira.component.requireLLMForMatureTests": true,
  "qaira.component.maxLlmComponents": 12,
  "qaira.component.maxTestsPerComponent": 8,
  "qaira.component.maxExecutableSpecs": 50,
  "qaira.component.contractOnlyForUnresolved": true,
  "qaira.component.runSmokeOnlyFirst": true,

  "qaira.component.installPlaywrightDependencies": true,
  "qaira.component.playwrightPackageVersion": "1.54.0",
  "qaira.component.ensureBrowsers": true,

  "qaira.component.dockerImage": "mcr.microsoft.com/playwright:v1.54.0-noble"
}