{
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "editor.detectIndentation": true,
  "editor.renderWhitespace": "selection",
  "search.useIgnoreFiles": true,
  "search.exclude": {
    "**/dist": true,
    "**/dist-admin": true,
    "**/coverage": true,
    "**/.hellotest": true,
    "**/.cache": true,
    "local-run/artifacts": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/dist-admin/**": true,
    "**/coverage/**": true,
    "**/.cache/**": true,
    "**/.hellotest/**": true,
    "**/local-run/artifacts/**": true
  },
  "hellotest.outputDir": "out/hellotest-output",
  "hellotest.learningDir": "out/hellotest-learning",

  "hellotest.configPath": "",

  "hellotest.docker.image": "jayarajumetta/semantic-compiler:1.9.2",
  "hellotest.docker.pullPolicy": "always",

  "hellotest.import.apiTests.enabled": true,
  "hellotest.import.webuiPages.enabled": true,
  "hellotest.import.apiTestsUrl": "http://localhost:8080/api/test-cases/import",
  "hellotest.import.webuiPagesUrl": "http://localhost:8080/api/test-cases/automation/learning-cache/import",
  "hellotest.import.appTypeId": "fb1192f3-9421-4012-b616-c13bbcb5bbe3",
  "hellotest.import.authMode": "x-api-key",
  "hellotest.import.confirmBeforeSending": true,

  "hellotest.llm.enable": "true",
  "hellotest.llm.provider": "openai",
  "hellotest.llm.endpoint": "https://api.openai.com/v1/chat/completions",
  "hellotest.llm.model": "gpt-4.1-mini",
  "hellotest.llm.executeNetworkCalls": true,
  "hellotest.llm.callsPerRun": 12,
  "hellotest.llm.timeoutSeconds": 45,

  "hellotest.component.framework": "auto",
  "hellotest.component.executionMode": "local",
  "hellotest.component.ctWorkspaceDir": "generated/component-ct",
  "hellotest.component.workspaceMode": "shadow",

  "hellotest.component.matureValidationTests": true,
  "hellotest.component.requireLLMForMatureTests": true,
  "hellotest.component.maxLlmComponents": 12,
  "hellotest.component.maxTestsPerComponent": 8,
  "hellotest.component.maxExecutableSpecs": 50,
  "hellotest.component.contractOnlyForUnresolved": true,
  "hellotest.component.runSmokeOnlyFirst": true,

  "hellotest.component.installPlaywrightDependencies": true,
  "hellotest.component.playwrightPackageVersion": "1.54.0",
  "hellotest.component.ensureBrowsers": true,

  "hellotest.component.dockerImage": "mcr.microsoft.com/playwright:v1.54.0-noble"
}
