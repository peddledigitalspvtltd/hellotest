# Local-only defaults for testengine/docker-compose.yml.
# Production deployments should use ./hellotest.sh deploy --stack testengine,
# which generates and persists independent strong service credentials.
HELLOTEST_API_BASE_URL=http://host.docker.internal:3000
HELLOTEST_TESTENGINE_SECRET=hellotest-testengine-dev-secret
MOBILE_ENGINE_SHARED_SECRET=hellotest-mobile-engine-dev-secret

TESTENGINE_BIND=127.0.0.1
TESTENGINE_PORT=4301
MOBILE_ENGINE_BIND=127.0.0.1
MOBILE_ENGINE_PORT=4312
SELENIUM_GRID_BIND=127.0.0.1
SELENIUM_VNC_BIND=127.0.0.1

# Optional comma-separated exact HTTP(S) origins for Build navigation (e.g. SSO).
# The start URL origin is already allowed. Inspection proxy private-host policy still applies.
AUTOMATION_NAVIGATION_ALLOWED_ORIGINS=

MOBILE_PROVIDER=local-appium
APPIUM_SERVER_URL=http://host.docker.internal:4723
MOBILE_REQUIRE_PROVIDER_READY=false
