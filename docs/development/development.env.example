# Host development only. Copy to <repository-root>/.env.development.local.
# Used by VS Code Node launch profiles and its infrastructure Compose tasks.
# These public development credentials are unsuitable for shared deployments.
# Keep literal values: do not use shell commands or variable interpolation.
# No common PORT: each launch profile assigns its own listener port.
NODE_ENV=development
APP_MODE=local
LOG_LEVEL=info
ENABLE_OBSERVABILITY=false
HELLOTEST_SERVICE_PROFILE=all
HELLOTEST_ENABLED_CAPABILITIES=all
HELLOTEST_SCHEMA_MODE=migrate

# Compose PostgreSQL initialization and host API must use matching values.
# Changing these values does not change credentials in an existing volume.
POSTGRES_DB=hellotest
POSTGRES_USER=hellotest
POSTGRES_PASSWORD=hellotest
PGHOST=localhost
PGPORT=5432
PGDATABASE=hellotest
PGUSER=hellotest
PGPASSWORD=hellotest
# DATABASE_URL / POSTGRES_URL override PG*; leave them unset for this workflow.
# The product and execution adapter currently share the same database.

# API sessions and service authentication. Rotate matching values together.
SESSION_SECRET=hellotest-dev-secret
TESTENGINE_SHARED_SECRET=hellotest-testengine-dev-secret
MOBILE_ENGINE_SHARED_SECRET=hellotest-mobile-engine-dev-secret
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
ADMIN_FRONTEND_INTERNAL_URL=http://localhost:5174

# Applies only when creating a fresh local administrator; does not reset users.
ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=admin

# Compose MinIO root identity and host API storage client must agree.
# Default image is prepared from pinned source; see ops/minio/README.md.
MINIO_IMAGE=hellotest/minio:RELEASE.2025-10-15T17-29-55Z
MINIO_ROOT_USER=hellotest
MINIO_ROOT_PASSWORD=hellotest-minio-dev-secret
STORAGE_PROVIDER=minio
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=hellotest
MINIO_SECRET_KEY=hellotest-minio-dev-secret
MINIO_BUCKET=hellotest-attachments

# TestEngine polls this development API; never point it at a shared queue.
HELLOTEST_API_BASE_URL=http://localhost:3000
ENGINE_PUBLIC_URL=http://localhost:4301
TESTENGINE_POLL_INTERVAL_MS=1000
TESTENGINE_QUEUE_REQUIRED=true
# Leave TESTENGINE_WORKER_CLASS unset for a hybrid local worker.
# VS Code provides an absolute ARTIFACT_ROOT for TestEngine.

# Optional Android/iOS provider: start it only when Appium/devices are ready.
MOBILE_ENGINE_URL=http://localhost:4312
APPIUM_SERVER_URL=http://localhost:4723
MOBILE_REQUIRE_PROVIDER_READY=true
# Redis, Tika, LLMs, source repositories and telemetry are not provisioned by F5.
# Configure optional providers through their documented environment/integrations.
